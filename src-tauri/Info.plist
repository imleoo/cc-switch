<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- we2ai: 注册 we2ai:// 自定义 URL 协议，用于深链接导入。
       本文件与 tauri.conf.json 的 plugins.deep-link.desktop.schemes 都声明了
       同一个 scheme，两处必须保持一致，由 check-guards.sh 4.3b 的品牌/scheme
       残留扫描保证。 -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>WE2AI Deep Link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>we2ai</string>
      </array>
    </dict>
  </array>
</dict>
</plist>

